# 容器运行环境（复制成 .env.docker 后 scripts/docker-run.sh 会 --env-file 读它）
# 完整开关清单与语义见 .env.example；这里是容器形态的推荐值。

# ── 形态 ────────────────────────────────────────────────
LAYA_ENGINE=laya_torch            # 容器必须 torch（Linux 没有 Metal）
LAYA_MODEL=multilingual           # multilingual | english | typed-decisions
LAYA_BACKEND=auto                 # auto | torch
LAYA_MODEL_DIR=/models/multilingual
LAYA_OPENAPI_VERSION=3.1          # 3.1（默认）| 3.0=主档降级为 3.0.3；/openapi-3.0.json 恒为 3.0.3
LAYA_OPENAPI_SERVER_URL=          # 文档 servers[0].url；平台导入建议写死成服务真实地址
LAYA_WARM_ON_START=1
LAYA_PREFIX_CACHE=1              # 重复问题集实测快约 6%

# ── 监听（容器内）────────────────────────────────────────
LAYA_API_HOST=0.0.0.0
LAYA_API_PORT=8765

# ── 并发与超时 ──────────────────────────────────────────
LAYA_MAX_QUEUE=16
LAYA_DEFAULT_TIMEOUT_MS=5000
LAYA_BUSY_RETRY_AFTER_S=1
LAYA_MAX_STATE_CHARS=4000
LAYA_MAX_OPTIONS=20

# ── 鉴权（对外暴露务必打开；密钥只在运行期注入，绝不进镜像）──
LAYA_AUTH_MODE=off                # off（默认，可信内网）| api_key
LAYA_API_KEYS=                    # 形如 key-a,key-b；多把便于轮换
LAYA_AUTH_HEADER=X-API-Key        # 也接受 Authorization: Bearer ***
LAYA_AUTH_PROTECT_STATUS=0        # 1=连 /v1/status 也要密钥
LAYA_AUTH_PUBLIC_PATHS=/healthz,/readyz,/docs,/redoc,/wiki,/ui,/openapi.json,/static
LAYA_RATE_LIMIT_PER_MIN=0         # 0=不限流；>0 按密钥令牌桶限流（429 + Retry-After）
LAYA_RATE_LIMIT_BURST=0           # 0=等于 per_min

# ── 权重挂载（可选）──────────────────────────────────────
# 默认权重已打进镜像；想外置就构建时让 weights/ 只留 .gitkeep，再用
# LAYA_MOUNT_MODELS=1 让 scripts/docker-run.sh 挂载宿主目录到 /models。
