# Laya 决策服务 · 全部开关（都是环境变量，改完重启进程或调 POST /v1/admin/reload）
# 用法：复制成 .env.docker（容器）或直接 export（前台/launchd）

# ── 形态 ────────────────────────────────────────────────
LAYA_ENGINE=laya_mlx              # laya_mlx(Mac/Metal) | laya_torch(Linux 容器) | hermes_laya(接 Hermes)
LAYA_MODEL=multilingual           # multilingual | english | typed-decisions
LAYA_BACKEND=auto                 # auto | mlx | coreml | torch
LAYA_MODEL_DIR=/models/multilingual   # 权重目录（容器挂载点）；Mac 留空用 ~/.cache/laya-models/<model>
LAYA_PREFIX_CACHE=1               # 1=缓存问题前缀（重复问题集实测快约 6%）
LAYA_OPENAPI_VERSION=3.1          # 3.1（FastAPI 原生）| 3.0=对外降级为 3.0.3（老平台导入用）；/openapi-3.0.json 恒为 3.0.3
LAYA_OPENAPI_SERVER_URL=          # 文档 servers[0].url；留空=相对路径 "/"，导出文件给平台时建议写死真实地址
LAYA_WARM_ON_START=1              # 1=启动即加载模型（首调用不等冷启动）

# ── 并发与超时（性能相关）───────────────────────────────
LAYA_MAX_QUEUE=16                 # 排队上限；满了直接 BUSY（让调用方退避，不无限堆积）
LAYA_DEFAULT_TIMEOUT_MS=5000      # 请求未指定 timeout_ms 时的默认超时
LAYA_BUSY_RETRY_AFTER_S=1         # BUSY/限流响应里的 Retry-After 秒数
LAYA_MAX_STATE_CHARS=4000         # 情境截断长度默认值
LAYA_MAX_OPTIONS=20               # 单问选项数上限默认值

# ── 鉴权（重要：容器对外暴露时务必打开）──────────────────
LAYA_AUTH_MODE=api_key            # off（默认，仅本机/可信内网）| api_key
LAYA_API_KEYS=key-a,key-b         # 多把并存便于轮换；只放环境/密钥文件，绝不进镜像与代码
LAYA_AUTH_HEADER=X-API-Key        # 也接受 Authorization: Bearer <key>
LAYA_AUTH_PROTECT_STATUS=0        # 1=连 /v1/status 也要密钥（默认放开，便于内网排障）
LAYA_AUTH_PUBLIC_PATHS=/healthz,/readyz,/docs,/redoc,/wiki,/ui,/openapi.json,/static
LAYA_RATE_LIMIT_PER_MIN=0         # 0=不限流；>0 时按密钥令牌桶限流（超限 429 + Retry-After）
LAYA_RATE_LIMIT_BURST=0           # 0=等于 per_min
